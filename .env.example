# Environment configuration template for Composio AI Product Ops Pipeline
# Copy this file to .env and populate with your credentials if performing live authenticated crawling

# Anthropic API Key for LLM-assisted verification and research
ANTHROPIC_API_KEY=

# Composio API Key for toolkit inspection and tool execution
COMPOSIO_API_KEY=

# Optional: User-Agent header for official doc crawling
CRAWLER_USER_AGENT="ComposioProductOpsBot/1.0 (+https://composio.dev)"

# Pipeline Settings
RESEARCH_CONCURRENCY=5
LOG_LEVEL=INFO
